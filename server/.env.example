# Copie ce fichier en ".env" puis adapte les valeurs.
PORT=3001

# --- Base de données sur ton PC (MySQL / XAMPP / WAMP) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pokemon_tcg_plateau

# --- OU base de données hébergée en ligne (Aiven, etc.) ---
# Remplace tout le bloc du dessus par l'adresse (« Service URI ») donnée par l'hébergeur :
# DATABASE_URL=mysql://avnadmin:MOTDEPASSE@mysql-xxxx.aivencloud.com:12345/defaultdb
# DB_SSL=true
# Certificat fourni par l'hébergeur (fichier à placer dans ce dossier) :
# DB_SSL_CA=ca.pem
